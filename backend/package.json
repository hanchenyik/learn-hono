{
  "name": "nimble-commerce-api",
  "private": true,
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true
  },
  "scripts": {
    "dev": "wrangler dev --env-file=../.env",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "db:migrate:local": "wrangler d1 migrations apply lumiere-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lumiere-db --remote",
    "db:seed:local": "wrangler d1 execute lumiere-db --local --file=./migrations/0002_seed_products.sql"
  },
  "dependencies": {
    "better-auth": "^1.6.23",
    "hono": "^4.13.3",
    "qrcode-svg": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@types/qrcode-svg": "^1.1.5",
    "better-sqlite3": "^12.11.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.92.0"
  }
}
