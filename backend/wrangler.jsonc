{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petitbakery-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGIN": "https://petitbakery-6gf.pages.dev/",
    "CORS_ORIGIN": "https://petitbakery-6gf.pages.dev/",
    "BETTER_AUTH_URL": "https://petitbakery-api.hanchenyik.workers.dev/",
    "EMAIL_FROM": "PetitBakery <onboarding@resend.dev>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "petitbakery-db",
      "database_id": "e542652e-4bf5-4fed-a310-e6869e03f89b"
    }
  ]
}
