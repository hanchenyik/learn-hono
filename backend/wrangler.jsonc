{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumiere-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGIN": "https://lumiere-bpk-cba.pages.dev",
    "CORS_ORIGIN": "https://lumiere-bpk-cba.pages.dev",
    "BETTER_AUTH_URL": "https://lumiere-api.velozz.workers.dev/api/auth",
    "EMAIL_FROM": "dehoulworker@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumiere-db",
      "database_id": "aa518f92-aebf-4dcd-868b-ec7d78072fc8"
    }
  ]
  
  
}
